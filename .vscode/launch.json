{
    "configurations": [
      {
        "name": "Cloud Run: Local Build - Run/Debug dev Locally",
        "type": "cloudcode.cloudrun",
        "request": "launch",
        "build": {
          "docker": {
            "path": "dev.Dockerfile",
            "buildArgs": {
              "APP_PORT": "8080"
            }
          }
        },
        "image": "hometips-strapi-ts",
        "service": {
          "name": "hometips-strapi-ts-dev1",
          "containerPort": 8080,
          "env": [
            {
              "name": "APP_PORT",
              "value": "8080"
            }
          ],
          "resources": {
            "limits": {
              "cpu": 1,
              "memory": "1024Mi"
            }
          }
        },
        "target": {
          "minikube": {}
        },
        "watch": true,
        "debug": {
          "sourceFileMap": {
            "${workspaceFolder}": "/opt/hometips-strapi-ts"
          }
        }
      }
    ]
}
