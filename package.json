{
  "name": "kvidai-documentation",
  "description": "Kvidai Documentation template-decap-cms-docusaurus",
  "packageManager": "pnpm@9.0.0",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build && node scripts/copy-build-files.js llms.txt llms-full.txt sitemap.xml",
    "postbuild": "node scripts/copy-build-files.js llms.txt llms-full.txt sitemap.xml",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "screenshots": "node scripts/copy-screenshots.js",
    "prebuild": "node scripts/copy-screenshots.js",
    "test": "(fuser -k 3100/tcp 2>/dev/null || true) && sleep 0.5 && playwright test --project=chromium",
    "test:screenshot": "playwright test tests/screenshot.spec.ts --project=chromium",
    "test:screenshot:serve": "BASE_URL=http://localhost:3000 playwright test tests/screenshot.spec.ts --project=chromium",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "deploy:preview": "netlify deploy --dir=build",
    "deploy:prod": "netlify deploy --dir=build --prod"
  },
  "dependencies": {
    "@docusaurus/core": "3.8.1",
    "@docusaurus/faster": "^3.8.1",
    "@docusaurus/preset-classic": "3.8.1",
    "@mdx-js/react": "^3.0.0",
    "@signalwire/docusaurus-plugin-llms-txt": "^1.2.1",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.8.1",
    "@docusaurus/tsconfig": "3.8.1",
    "@docusaurus/types": "3.8.1",
    "@modelcontextprotocol/sdk": "^1.15.1",
    "@playwright/test": "^1.54.1",
    "@types/node": "^24.0.13",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "autoprefixer": "^10.4.16",
    "node-fetch": "^3.3.2",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "zod": "^4.0.5"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=22.0"
  }
}
